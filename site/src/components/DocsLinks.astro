---
/**
 * Replaces Starlight's social icon row with the landing page's text nav:
 * lowercase links with the amber underline on hover.
 */
import GitHubStars from './GitHubStars.astro';

const links = [
  { label: 'home', href: '/' },
  { label: 'github', href: 'https://github.com/smarzban/tsk', stars: true },
];
---

<nav class="docs-links" aria-label="Site">
  {links.map(({ label, href, stars }) => <a href={href}>{label}{stars && <GitHubStars />}</a>)}
</nav>

<style>
  .docs-links {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.6vw, 1.35rem);
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
  }

  .docs-links a {
    position: relative;
    padding: 0.2rem 0;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .docs-links a::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .docs-links a:hover {
    color: var(--sl-color-white);
  }

  .docs-links a:hover::before {
    transform: scaleX(1);
  }
</style>

