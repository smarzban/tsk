---
import Wordmark from '../components/Wordmark.astro';
import SharedHead from '../components/SharedHead.astro';
import '../styles/landing.css';

import { serializeJsonLd } from '../lib/agent-docs.mjs';
import { VERSION } from '../version.mjs';
const SITE = 'https://gettsk.sh';
const REPO = 'https://github.com/smarzban/tsk';
const ICON_DOCS =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.2C10.4 4.1 8.2 3.5 5.6 3.5c-1 0-2 .1-3.1.3v14.4c1-.2 2-.3 3.1-.3 2.5 0 4.7.6 6.4 1.9 1.7-1.3 3.9-1.9 6.4-1.9 1.1 0 2.1.1 3.1.3V3.8c-1.1-.2-2.1-.3-3.1-.3-2.6 0-4.8.6-6.4 1.7zm-.9 12.4c-1.5-.9-3.4-1.3-5.5-1.3-.5 0-1 0-1.5.1V5.4c.5-.1 1-.1 1.5-.1 2.2 0 4.1.5 5.5 1.5v10.8zm1.8-10.8c1.4-1 3.3-1.5 5.5-1.5.5 0 1 0 1.5.1v11c-.5-.1-1-.1-1.5-.1-2.1 0-4 .4-5.5 1.3V6.8z"/></svg>';
const ICON_GITHUB =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>';
const PAGE_JUMPS = [
  { href: '#install', label: 'install' },
  { href: '#demo', label: 'demo' },
  { href: '#board', label: 'board' },
  { href: '#cli', label: 'cli' },
  { href: '#agents', label: 'agents' },
];
const BOARD_PINS = [
  {
    n: 1,
    title: 'Three tabs, always on screen.',
    body: '<b>desk</b> gathers work across every project. The middle tab is your selected project; <kbd>p</kbd> picks a different one. <b>projects</b> is the index of them all. <kbd>1</kbd>, <kbd>2</kbd>, <kbd>3</kbd> jump between them; the active tab is underlined.',
  },
  {
    n: 2,
    title: 'NEEDS YOU.',
    body: 'Blocked and review across all projects on Desk, or within the selected project on its board, above IN MOTION.',
  },
  {
    n: 3,
    title: 'A task.',
    body: 'A selection arrow without a filled highlight, status glyph, a dim <code>T</code>-number you can click to copy, and the wrapped title. Project or thread attribution appears only at the bottom of an open peek.',
  },
  {
    n: 4,
    title: 'Peek.',
    body: 'Below 110 columns, <kbd>→</kbd>, <kbd>l</kbd>, or a click shows up to five wrapped note lines under the task. Wide, those keys or a click open the task page beside the board instead. <kbd>←</kbd> or <kbd>h</kbd> closes it; <kbd>Enter</kbd> opens the full page.',
  },
  {
    n: 5,
    title: 'Your loose backlog.',
    body: "Desk's ON DECK contains only tasks without a project. Picked <code>ready</code> tasks lead, then the expandable <code>inbox</code> of <code>open</code> tasks. Project backlogs live on their own boards, with thread filters across every status.",
  },
];
const pinLabel = (n) => {
  const pin = BOARD_PINS.find((p) => p.n === n);
  return pin ? `${n}. ${pin.title}` : String(n);
};
const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'tsk',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows 10, Windows 11',
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: REPO,
  softwareVersion: VERSION,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>tsk · a task board for you and your agents</title>
    <meta
      name="description"
      content="tsk is a terminal task board for you and your agents: one shared queue, a TUI for you, a CLI for them."
    />
    <link rel="canonical" href={`${SITE}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tsk" />
    <meta property="og:title" content="tsk · a task board for you and your agents" />
    <meta
      property="og:description"
      content="One board in your terminal where you and your agents plan and move work. You and your agents can create, edit, and complete tasks."
    />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="tsk · a task board for you and your agents" />
    <meta
      name="twitter:description"
      content="One board in your terminal where you and your agents plan and move work. You and your agents can create, edit, and complete tasks."
    />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <script is:inline>
      (function () {
        var k = 'tsk-theme';
        var t = null;
        try {
          t = localStorage.getItem(k) || localStorage.getItem('starlight-theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = 'dark';
        document.documentElement.dataset.theme = t;
        document.documentElement.style.colorScheme = t;
        try {
          localStorage.setItem(k, t);
          localStorage.setItem('starlight-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/icon-dark.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/icon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/icon-light.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon-light.png"
      media="(prefers-color-scheme: light)"
    />
    <SharedHead />
    <script type="application/ld+json" set:html={serializeJsonLd(softwareApplication)} />
  </head>
  <body class="landing">
    <a class="skip" href="#main">skip to content</a>

    <header class="top">
      <div class="top-inner">
        <a class="wordmark" href="/" aria-label="tsk home"><Wordmark /></a>
        <span class="ver" title="crate and plugin version">v{VERSION}</span>
        <nav class="top-nav" aria-label="Primary">
          <div class="nav-links">
            <details class="goto" data-goto>
              <summary class="goto-chip" aria-label="Go to" aria-controls="goto-menu">
                <span class="prompt" aria-hidden="true">:</span>
                <span class="goto-label">goto</span>
                <span class="caret" aria-hidden="true">▾</span>
              </summary>
              <div class="goto-menu" id="goto-menu">
                {PAGE_JUMPS.map(({ href, label }) => (
                  <a href={href}>{label}</a>
                ))}
              </div>
            </details>
            <span class="nav-dot" aria-hidden="true">.</span>
            <a class="nav-text" href="/docs/">docs</a>
            <span class="nav-dot" aria-hidden="true">.</span>
            <a class="nav-text" href={REPO} rel="noopener noreferrer">github</a>
          </div>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label="Switch to light mode"
            aria-pressed="true"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ───────────────────────────── hero ───────────────────────────── -->
      <section class="hero" aria-labelledby="headline">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="prompt">$</span> tsk
              <span class="dim">· a task board in your terminal · herdr plugin, runs standalone</span>
            </p>
            <h1 class="headline" id="headline">
              A task board<br />for you and<br />your agents<span class="block-cursor" aria-hidden="true"></span>
            </h1>
            <p class="lede">
              One board where you both plan, pick up work, and move it through
              <b>open</b>, <b>ready</b>, <b>started</b>, <b>blocked</b>, <b>review</b>, <b>done</b>.
              You and your agents can create, edit, and complete tasks.
            </p>
            <div class="hero-install">
              <div class="shell-wrap">
                <pre class="shell" data-copy-source><span class="prompt">$</span> curl -fsSL https://gettsk.sh/install.sh | sh</pre>
                <button type="button" class="copy" data-copy aria-label="Copy install command">copy</button>
              </div>
              <p class="hero-install-meta">
                macOS &amp; Linux · MIT · <a href="#demo">Try the board ↓</a>
                · <a href="/docs/install/">install guide →</a> · Windows 10/11 PowerShell
              </p>
            </div>
          </div>

          <div class="hero-side" data-board-pins>
            <div class="screen" role="group" aria-label="A tsk board at 78 columns. Hover or click a number for its callout.">
              <div class="s-row s-tabs is-on">
                <span class="l"><span class="on">desk</span><span class="dim">  ·  </span>tsk ▾<span class="dim">  ·  </span>projects</span>
                <button type="button" class="pin is-on" data-pin="1" aria-label={pinLabel(1)} aria-controls="pin-card" aria-expanded="true">1</button>
              </div>
              <div class="s-gap"></div>
              <div class="s-row s-sec">
                <span class="sec">NEEDS YOU</span><span class="rule"></span><span class="count">2</span>
                <button type="button" class="pin" data-pin="2" aria-label={pinLabel(2)} aria-controls="pin-card" aria-expanded="false">2</button>
              </div>
              <div class="s-gap"></div>
              <div class="s-row s-task is-sel">
                <span class="l">▸ <span class="glyph">▲</span> <span class="tid">T31</span> <span class="sel-text">Review the release checklist</span></span>
                <button type="button" class="pin" data-pin="3" aria-label={pinLabel(3)} aria-controls="pin-card" aria-expanded="false">3</button>
              </div>
              <div class="s-row s-peek"><span class="l dim">  │ Steps live on the task page. Notes wrap, never truncate.</span></div>
              <div class="s-row s-peek"><span class="l dim">  └─ tsk</span>
                <button type="button" class="pin" data-pin="4" aria-label={pinLabel(4)} aria-controls="pin-card" aria-expanded="false">4</button>
              </div>
              <div class="s-row s-task">
                <span class="l"><span class="glyph">■</span> <span class="tid">T29</span> Waiting on the pane label</span>
              </div>
              <div class="s-gap"></div>
              <div class="s-row s-sec">
                <span class="sec">IN MOTION</span><span class="rule"></span><span class="count">1</span>
              </div>
              <div class="s-gap"></div>
              <div class="s-row s-task">
                <span class="l"><span class="glyph">●</span> <span class="tid">T27</span> Proof the landing copy once more</span>
              </div>
              <div class="s-gap"></div>
              <div class="s-row s-sec">
                <span class="sec">ON DECK · desk</span><span class="rule"></span><span class="count">4</span>
                <button type="button" class="pin" data-pin="5" aria-label={pinLabel(5)} aria-controls="pin-card" aria-expanded="false">5</button>
              </div>
              <div class="s-row s-task">
                <span class="l"><span class="glyph">○</span> <span class="tid">T25</span> Draft the announcement</span>
              </div>
              <div class="s-row s-task">
                <span class="l"><span class="glyph">○</span> <span class="tid">T18</span> Global backlog note</span>
              </div>
              <div class="s-row s-sub"><span class="sec">inbox</span><span class="count">2</span></div>
              <div class="s-row s-task">
                <span class="l"><span class="glyph">◌</span> <span class="tid">T24</span> Capture the loose idea</span>
              </div>
              <div class="s-row s-task">
                <span class="l"><span class="glyph">◌</span> <span class="tid">T30</span> Triage the new report</span>
              </div>
              <div class="s-fill"></div>
              <div class="s-row s-footrule"><span class="rule"></span></div>
              <div class="s-row s-foot">
                <span class="l meta">desk</span>
              </div>
              <div class="s-row s-foot">
                <span class="l meta">enter open · ctrl+d done · ctrl+n next · ctrl+o inbox · ? help</span>
              </div>
            </div>
            {BOARD_PINS.map((pin) => (
              <template data-pin-copy={pin.n}>
                <b>{pin.title}</b>{" "}<Fragment set:html={pin.body} />
              </template>
            ))}
            <div class="pin-card" id="pin-card" aria-live="polite">
              <span class="pin-card-n" data-pin-n>1</span>
              <div class="pin-card-body" data-pin-body>
                <b>{BOARD_PINS[0].title}</b>{" "}<Fragment set:html={BOARD_PINS[0].body} />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ───────────────────────────── why ────────────────────────────── -->
      <section class="band band-alt" id="why" aria-labelledby="why-heading">
        <div class="band-inner" data-reveal>
          <header class="band-head">
            <span class="index">01 <span class="index-label">why</span></span>
            <h2 id="why-heading">Not another to-do app.</h2>
            <p class="band-lede">
              tsk is the shared surface between a developer and the agents working beside
              them. It lives in the pane you already have open. No browser tab, no sync
              service, no form takeover.
            </p>
          </header>

          <div class="pillars">
            <article class="pillar">
              <h3>Capture never leaves the list.</h3>
              <p>
                <kbd>+</kbd> opens one line on the status row. <kbd>Enter</kbd> saves,
                <kbd>Shift+Enter</kbd> keeps the line open, <kbd>Tab</kbd> expands onto the task
                page. Two tokens set project and thread from inside the title.
              </p>
              <pre class="mini" aria-label="Quick-add example"><span class="prompt">+</span> Fix the flaky bench <span class="tok">!p</span> tsk <span class="tok">!t</span> ci<span class="cursor" aria-hidden="true">█</span>
<span class="dim">enter save · shift+enter stay · tab page · esc close</span></pre>
            </article>

            <article class="pillar">
              <h3>Nothing completes itself.</h3>
              <p>
                Every mutating verb needs <kbd>Ctrl</kbd>. Bare letters do nothing, so a stray
                keystroke in a focused board cannot finish or delete work. Undo is one chord
                away.
              </p>
              <pre class="mini" aria-label="Verb bar"><span class="dim">enter</span> open · <span class="dim">ctrl+d</span> done · <span class="dim">ctrl+n</span> ready · <span class="dim">ctrl+o</span> open · <span class="dim">:</span> palette
<span class="dim">ctrl+x</span> delete · <span class="dim">ctrl+u</span> undo · <span class="dim">?</span> help · <span class="dim">+</span> capture</pre>
            </article>

            <article class="pillar">
              <h3>One store. Everyone at the table.</h3>
              <p>
                You, herdr's quick-capture popup, and your agents edit the same
                <code>~/.tsk</code>. An agent drops a plan in as JSON, new tasks enter the inbox, and the board shows them on
                the next tick.
              </p>
              <pre class="mini" aria-label="Three ways in"><span class="prompt">$</span> cat plan.json | tsk add
<span class="dim">&#123; "created": [T33, T34, T35], "existing": [], "failed": [] &#125;</span>
<span class="prompt">$</span> herdr plugin action invoke quick-capture --plugin herdr-tsk</pre>
            </article>
          </div>
        </div>
      </section>

      <!-- ─────────────────────────── live demo ────────────────────────── -->
      <section class="stage" id="demo" aria-labelledby="demo-heading">

        <div class="stage-inner">
          <div class="demo-invitation"><h2 id="demo-heading">Try it. This board is yours to play with.</h2><p>Double-click a task to open it, check off a step, or press + to add your own. Switch to Projects at a wide width, then move to a project to preview its board. Explore auth, API, and reliability work with threads and checklists. Press Shift+M to mark several tasks and act on them at once. Changes stay in this demo; refresh to start over.</p></div>
          <div
            class="pane"
            id="board-demo"
            tabindex="0"
            role="application"
            aria-label="tsk board live demo"
          >
            <div class="pane-bar">
              <span class="pane-tab"><span class="pane-dot" aria-hidden="true"></span>tsk</span>
              <div class="layout-toggle" role="group" aria-label="Terminal layout">
                <button type="button" data-layout="full" aria-pressed="true">full terminal</button>
                <button type="button" data-layout="beside" aria-pressed="false">beside your agent</button>
              </div>
              <span class="pane-cols" data-cols aria-live="polite"></span>
              <span class="pane-hint">
                drag the divider · <kbd>j</kbd><kbd>k</kbd> move · <kbd>h</kbd><kbd>l</kbd> close or open ·
                <kbd>+</kbd> capture · <kbd>?</kbd> help
              </span>
            </div>
            <div class="split is-full" data-split>
              <aside class="agent" aria-label="A coding agent session beside the board, static example">
                <div class="agent-bar"><span><b>coding agent</b> · ~/work/launchpad</span><span>static example</span></div>
                <div class="agent-body">
                  <p class="agent-line you">webhook retries are applying the same event twice. investigate and add a task.</p>
                  <p class="agent-line say">The handler applies side effects before recording the event ID. Concurrent retries can both get through.</p>
                  <div class="agent-tool"><span class="tool-name">Bash</span><span class="tool-arg">tsk add -t "Make webhook delivery idempotent" -p launchpad --thread api --json</span><span class="tool-out" data-cli-add-output>&#123;"outcome":"created","id":"00000000-0000-4000-8000-000000000013","number":13,"title":"Make webhook delivery idempotent","project":"/home/agent/work/launchpad"&#125;</span></div>
                  <div class="agent-tool"><span class="tool-name">Bash</span><span class="tool-arg">tsk steps T13 add "Reproduce duplicate delivery"</span><span class="tool-out" data-cli-step-output>added 3f Reproduce duplicate delivery</span></div>
                  <p class="agent-line say">T13 is open with a checklist to reproduce duplicate delivery, persist processed event IDs, and test concurrent retries. Pick it when you are ready to work.</p>
                </div>
                <div class="agent-input"><span class="agent-prompt">›</span><span class="cursor" aria-hidden="true"></span><span class="agent-shortcut">? for shortcuts</span></div>
              </aside>
              <div
                class="divider"
                role="separator"
                aria-orientation="vertical"
                aria-label="Resize the board. Arrow keys move it."
                tabindex="0"
                data-divider
              ></div>
              <div class="board tsk-demo" id="tsk-demo"></div>
            </div>
          </div>
          <p class="stage-note">
            Two real layouts. Beside an agent, tsk is the 78-column board herdr opens by default,
            and <kbd>→</kbd> or <kbd>l</kbd> peeks. Give it the whole terminal, or drag the divider past 110
            columns, and the same board becomes the four-stage slider: <kbd>→</kbd> or <kbd>l</kbd> slides the
            task page in. On the Projects tab, moving to a project opens its preview at Split,
            and <kbd>→</kbd> or <kbd>l</kbd> makes that project board live at Rail. The demo takes bare
            <kbd>s</kbd> <kbd>n</kbd> <kbd>o</kbd> <kbd>d</kbd> <kbd>b</kbd>
            because browsers keep the control chords. In the app, every mutating verb needs
            <kbd>Ctrl</kbd>. <kbd>Esc</kbd> closes either split after its editors and overlays.
            At the full-board root, <kbd>Esc</kbd> exits the terminal app;
            here it only releases keyboard focus, keeping the current tab. This demo covers marking and updating task sets, browsing, opening tasks, plus adding, checking, renaming and removing steps. Full task editing and save recovery remain unfinished.
          </p>
        </div>
      </section>

      <!-- ──────────────────────────── board ───────────────────────────── -->
      <section class="band" id="board" aria-labelledby="board-heading">
        <div class="band-inner" data-reveal>
          <header class="band-head">
            <span class="index">02 <span class="index-label">board</span></span>
            <h2 id="board-heading">One list, ordered by urgency.</h2>
            <p class="band-lede">
              Inside Git, start on the repo’s project board. Outside Git, start on <b>desk</b> with the current directory one tab away. <b>desk</b> shows what
              needs you across projects, active work, and your loose backlog. The selected
              <b>project</b> stays one key away; <b>projects</b> is a searchable index with
              a View selector for cross-project threads. Filter threads within a project
              with <kbd>t</kbd>, or across projects with <kbd>v</kbd> on the index.
              Give the board 110 columns and it becomes a slider.
            </p>
          </header>

          <div class="stages">
            <div class="stages-head">
              <h3>Wide: the four-stage slider.</h3>
              <p>At 110 columns and up, focus and geometry are the same thing. One rule, one footer, no colour.</p>
            </div>
            <ol class="stage-strip" aria-label="The four stages: board, split, rail, page">
              <li>
                <div class="frame f-0" aria-hidden="true"><i class="b is-focus"></i></div>
                <div class="stage-name"><b>Board</b></div>
                <div class="stage-focus">full width · board has focus</div>
              </li>
              <li>
                <div class="frame f-a" aria-hidden="true"><i class="b is-focus"></i><i class="r"></i><i class="t"></i></div>
                <div class="stage-name"><b>Split</b></div>
                <div class="stage-focus">board 40%, task page beside it · board has focus</div>
              </li>
              <li>
                <div class="frame f-g" aria-hidden="true"><i class="b is-dim"></i><i class="r"></i><i class="t is-focus"></i></div>
                <div class="stage-name"><b>Rail</b></div>
                <div class="stage-focus">dim 32-column rail, task page · task has focus</div>
              </li>
              <li>
                <div class="frame f-f" aria-hidden="true"><i class="t is-focus"></i></div>
                <div class="stage-name"><b>Page</b></div>
                <div class="stage-focus">full width · task has focus</div>
              </li>
            </ol>
            <p class="stages-keys">
              <span><kbd>→</kbd> / <kbd>l</kbd> one stage right</span>
              <span><kbd>←</kbd> / <kbd>h</kbd> one stage left</span>
              <span><kbd>Enter</kbd> jump to the page and remember where you were</span>
              <span><kbd>Esc</kbd> go back there</span>
            </p>
          </div>
        </div>
      </section>

      <!-- ──────────────────────────── status ──────────────────────────── -->
      <section class="band band-alt" id="status" aria-labelledby="status-heading">
        <div class="band-inner" data-reveal>
          <header class="band-head">
            <span class="index">03 <span class="index-label">status</span></span>
            <h2 id="status-heading">One workflow for you and your agents.</h2>
            <p class="band-lede">
              Six states shared by everyone on the board. You and your agents can create tasks,
              edit titles and notes, manage steps, and move tasks through the board, from <b>open</b>
              to <b>done</b>, using the CLI. Checking every step leaves the task status unchanged until it is explicitly updated.
            </p>
          </header>

          <ol class="rail" aria-label="Task statuses">
            <li>
              <span class="rail-glyph" aria-hidden="true">◌</span>
              <span class="rail-name">open</span>
              <span class="rail-how">inbox</span>
              <kbd>ctrl+o</kbd>
            </li>
            <li>
              <span class="rail-glyph" aria-hidden="true">○</span>
              <span class="rail-name">ready</span>
              <span class="rail-how">on deck</span>
              <kbd>ctrl+n</kbd>
            </li>
            <li>
              <span class="rail-glyph" aria-hidden="true">●</span>
              <span class="rail-name">started</span>
              <span class="rail-how">in motion</span>
              <kbd>ctrl+s</kbd>
            </li>
            <li>
              <span class="rail-glyph" aria-hidden="true">■</span>
              <span class="rail-name">blocked</span>
              <span class="rail-how">waiting</span>
              <kbd>ctrl+b</kbd>
            </li>
            <li>
              <span class="rail-glyph" aria-hidden="true">▲</span>
              <span class="rail-name">review</span>
              <span class="rail-how">check it</span>
              <kbd>ctrl+r</kbd>
            </li>
            <li>
              <span class="rail-glyph" aria-hidden="true">✓</span>
              <span class="rail-name">done</span>
              <span class="rail-how">in the drawer</span>
              <kbd>ctrl+d</kbd>
            </li>
          </ol>

          <div class="cycle" data-cycle aria-live="off">
            <div class="cycle-row">
              <span class="cycle-sec" data-cycle-sec>inbox</span>
              <span class="cycle-glyph" data-cycle-glyph aria-hidden="true">◌</span>
              <span class="tid">T14</span>
              <span class="cycle-title">Ship the landing page</span>
              <span class="cycle-meta">tsk</span>
            </div>
            <div class="cycle-foot">
              <span class="dim">you press</span>
              <kbd data-cycle-key>ctrl+n</kbd>
              <span class="dim">→</span>
              <span data-cycle-next>ready</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ────────────────────────────── cli ───────────────────────────── -->
      <section class="band" id="cli" aria-labelledby="cli-heading">
        <div class="band-inner" data-reveal>
          <header class="band-head">
            <span class="index">04 <span class="index-label">cli</span></span>
            <h2 id="cli-heading">Built for agents from the first commit.</h2>
            <p class="band-lede">
              Headless <code>add</code>, <code>list</code>, <code>status</code>, <code>edit</code>, and <code>steps</code> against the
              same store. An agent drops a plan in as JSON and it lands as <b>open</b> tasks in the inbox. It
              can move status, rewrite notes, check off steps, and mark work done.
            </p>
          </header>

          <div class="cli-grid">
            <div class="cli-main">
              <pre class="shell" aria-label="CLI session"><span class="prompt">$</span> tsk add -t "Draft release notes" -p tsk --thread release --json
<span class="dim">&#123;"outcome":"created","id":"5c1e…","number":32,"title":"Draft release notes","project":"tsk"&#125;</span>
<span class="prompt">$</span> tsk steps T32 add "Write the failing test"
<span class="dim">added 9f Write the failing test</span>
<span class="prompt">$</span> tsk status T32 start
<span class="dim">status T32 started Draft release notes</span>
<span class="prompt">$</span> tsk list T32
<span class="dim">STARTED
 - 32 Draft release notes #release
   [ ] 9f Write the failing test</span>
<span class="prompt">$</span> cat plan.json | tsk add
<span class="dim">&#123; "created": [...], "existing": [...], "failed": [] &#125;</span></pre>

              <section class="agent-block" id="agents" aria-labelledby="agents-heading">
                <h3 class="side-title" id="agents-heading">Paste this into your agent</h3>
                <div class="agent-handoff">
                  <div class="shell-wrap">
                    <pre class="shell" data-copy-source>Use tsk for my task board. Run `tsk guide` and follow it; if tsk is not installed, read https://gettsk.sh/docs/agents.md and ask me before installing.</pre>
                    <button type="button" class="copy" data-copy aria-label="Copy bootstrap prompt">copy</button>
                  </div>
                </div>
                <p class="band-lede">
                  Everything an agent needs is one command or one URL. Every docs page is
                  also Markdown: <span class="md-twin"><code>/docs/cli/</code> is <code>/docs/cli.md</code></span>.
                </p>
              </section>
            </div>

            <div class="cli-side">
              <h3 class="side-title">Exit contract</h3>
              <table class="exits">
                <tbody>
                  <tr><th scope="row">0</th><td>listed, created, existed, or applied</td></tr>
                  <tr><th scope="row">1</th><td>one or more item refusals. Retry the failed subset.</td></tr>
                  <tr><th scope="row">2</th><td>usage or parse error. Nothing persisted.</td></tr>
                  <tr><th scope="row">3</th><td>store I/O. Indeterminate. <code>tsk list</code> before retrying.</td></tr>
                </tbody>
              </table>
              <ul class="agent-paths" aria-label="Agent surfaces">
                <li class="shell-wrap">
                  <span class="agent-path-k">skill</span>
                  <pre class="shell" data-copy-source>tsk setup grok</pre>
                  <button type="button" class="copy" data-copy aria-label="Copy skill command">copy</button>
                </li>
                <li class="shell-wrap">
                  <span class="agent-path-k">docs</span>
                  <pre class="shell" data-copy-source>https://gettsk.sh/docs/cli.md</pre>
                  <button type="button" class="copy" data-copy aria-label="Copy docs markdown URL">copy</button>
                </li>
              </ul>
              <p class="side-note">
                Adds are idempotent on title, project, and thread. <code>--json</code> is flat
                and stable. <a href="/docs/cli/">CLI reference →</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ──────────────────────────── install ─────────────────────────── -->
      <section class="band band-alt" id="install" aria-labelledby="install-heading">
        <div class="band-inner" data-reveal>
          <header class="band-head">
            <span class="index">05 <span class="index-label">install</span></span>
            <h2 id="install-heading">Install it. Open the board.</h2>
            <p class="band-lede">
              One binary, standalone or in Herdr. State lives in <code>~/.tsk</code> on macOS/Linux or
              <code>%LOCALAPPDATA%\tsk</code> on Windows, whether you run it bare or inside Herdr.
            </p>
          </header>

          <div class="install" data-install>
            <div class="tabs" role="tablist" aria-label="Install mode">
              <button type="button" role="tab" id="tab-standalone" aria-selected="true" aria-controls="panel-standalone" data-install-tab="standalone">install</button>
              <button type="button" role="tab" id="tab-plugin" aria-selected="false" aria-controls="panel-plugin" data-install-tab="plugin" tabindex="-1">add to herdr</button>
            </div>

            <div class="tabpanel" role="tabpanel" id="panel-standalone" aria-labelledby="tab-standalone" data-install-panel="standalone">
              <div class="shell-wrap">
                <pre class="shell" data-copy-source><span class="prompt">$</span> curl -fsSL https://gettsk.sh/install.sh | sh</pre>
                <button type="button" class="copy" data-copy aria-label="Copy install command">copy</button>
              </div>
              <p class="install-note">Or install with Homebrew:</p>
              <div class="shell-wrap">
                <pre class="shell" data-copy-source><span class="prompt">$</span> brew install smarzban/tap/tsk</pre>
                <button type="button" class="copy" data-copy aria-label="Copy Homebrew command">copy</button>
              </div>
              <p class="install-note">Windows 10/11 ARM64 or x86-64:</p>
              <div class="shell-wrap">
                <pre class="shell" data-copy-source><span class="prompt">PS&gt;</span> &amp; &#123; irm https://www.gettsk.sh/install.ps1 | iex &#125;</pre>
                <button type="button" class="copy" data-copy aria-label="Copy Windows install command">copy</button>
              </div>
              <p class="install-note">
                If prompted on macOS or Linux, reopen your terminal or run the installer's printed <code>export</code> command.
                When Herdr is already installed, an interactive install may ask to run <code>tsk setup herdr</code>;
                when agent skill roots are detected it also asks once to install the tsk skill.
                The wrap-up then points at the board (<code>prefix+t</code> after Herdr setup, or <code>tsk setup herdr</code> / <code>tsk setup</code> when those asks are skipped).
                Open the board with <code>tsk</code>. Add a task with <code>tsk add -t "your task title"</code>.
                <a href="/docs/install/">Installation details</a>.
              </p>
            </div>

            <div class="tabpanel" role="tabpanel" id="panel-plugin" aria-labelledby="tab-plugin" data-install-panel="plugin" hidden>
              <div class="shell-wrap">
                <pre class="shell" data-copy-source><span class="prompt">$</span> tsk setup herdr
<span class="prompt">$</span> herdr server reload-config</pre>
                <button type="button" class="copy" data-copy aria-label="Copy Herdr setup commands">copy</button>
              </div>
              <p class="install-note">
                After installing, connect the same binary to Herdr (the curl installer may offer this when Herdr is already present). Press <code>prefix+t</code> to open or focus
                this workspace's board across tabs, or <code>prefix+a</code> to add a task. Other workspaces keep their boards. Setup asks before replacing conflicting shortcuts.
              </p>
            </div>

            <ul class="reqs" aria-label="Requirements">
              <li><span class="dim">install</span> shell, PowerShell, or Homebrew</li>
              <li><span class="dim">on</span> Linux · macOS · Windows 10/11 ARM64 or x64</li>
              <li><span class="dim">plugin mode</span> herdr 0.9+</li>
              <li><a href="/docs/install/">Full install guide →</a></li>
            </ul>
          </div>
        </div>
      </section>
      <section class="band" id="coming-soon" aria-labelledby="coming-soon-heading">
        <div class="band-inner" data-reveal>
          <header class="band-head">
            <span class="index">06 <span class="index-label">next phase</span></span>
            <p class="coming-announcement">Coming soon</p>
            <h2 id="coming-soon-heading">From task to implementation.</h2>
            <p class="band-lede">
              The next phase brings agent execution into the board: assign a task to an agent,
              start implementation from tsk, and run the work in Herdr worktrees.
            </p>
          </header>
          <ol class="coming-steps" aria-label="Planned agent workflow">
            <li><span class="dim">01</span><h3>Assign an agent.</h3><p>Choose who takes on the task, with its notes and steps as the brief.</p></li>
            <li><span class="dim">02</span><h3>Start from the board.</h3><p>Initiate implementation where you already plan and track the work.</p></li>
            <li><span class="dim">03</span><h3>Work in Herdr worktrees.</h3><p>Give the implementation its own worktree alongside your other work.</p></li>
          </ol>
          <p class="coming-availability">Planned for the next phase. Not available in the current build.</p>
        </div>
      </section>
    </main>

